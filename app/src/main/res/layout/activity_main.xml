<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvPlanTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="今日復健計畫"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="80dp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_card"
        android:padding="20dp"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvPlanTitle"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tvTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MediaPipe 核心運算 - 訓練動作"
            android:textSize="12sp"
            android:textColor="#666666"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <Spinner
            android:id="@+id/spinnerAction"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_rounded_spinner"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvTag"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvDifficultyTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="選擇難度等級"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/spinnerAction"
            app:layout_constraintStart_toStartOf="parent"/>

        <Spinner
            android:id="@+id/spinnerDifficulty"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_rounded_spinner"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvDifficultyTag"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="請選擇上方的動作與難度進行訓練"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/spinnerDifficulty"
            app:layout_constraintStart_toStartOf="parent"/>

        <Button
            android:id="@+id/btnStartTraining"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="開始 AI 訓練 ►"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1A24"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvSub"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>